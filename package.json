{
  "name": "the-missing-peace",
  "version": "0.1.0",
  "private": true,
  "description": "The Missing Peace \u2014 a Wedding Planning Engine",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "pages:build": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-pages.mjs",
    "pages:preview": "pnpm run pages:build && wrangler --cwd cloudflare-pages pages dev ../.open-next/pages",
    "pages:deploy": "pnpm run pages:build && wrangler --cwd cloudflare-pages pages deploy ../.open-next/pages --project-name=themissingpeace",
    "prototype:build": "node scripts/prepare-prototype-pages.mjs",
    "prototype:preview": "pnpm run prototype:build && wrangler --cwd cloudflare-prototype pages dev --d1 DB=tmp-landing",
    "prototype:deploy": "pnpm run prototype:build && wrangler --cwd cloudflare-prototype pages deploy --commit-dirty=true",
    "deploy": "pnpm run prototype:deploy",
    "deploy:product": "pnpm run pages:deploy",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "@liveblocks/client": "^2.20.0",
    "@liveblocks/node": "^2.20.0",
    "@liveblocks/react": "^2.20.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "next": "^15.3.0",
    "pdf-lib": "1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-moveable": "^0.56.0",
    "resend": "^4.0.0",
    "tldraw": "^3.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.68.0"
  }
}